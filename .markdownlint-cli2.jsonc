{
  "config": {
    "default": true,
    "MD010": { "code_blocks": false }, // No hard tabs: allowed in code blocks, XenForo code uses tabs
    "MD013": false, // Max line length: off, prose lines aren't wrapped
    "MD024": { "siblings_only": true }, // No duplicate headings: only among siblings, so repeated subheadings are fine
    "MD025": { "front_matter_title": "" }, // One H1 per page: don't count the frontmatter title as an H1
    "MD033": false, // No inline HTML: off, MDX pages rely on HTML/JSX
    "MD034": false, // No bare URLs: off, its fix wraps URLs in <...>, which MDX rejects
    "MD036": false, // No bold text as headings: off, bold is used for admin menu paths
    "MD041": false, // First line must be an H1: off, pages start with frontmatter/imports
    "MD060": false, // Aligned table pipes: off, wide tables can't stay aligned
  },
  "globs": [
    "docs/manual.mdx",
    "docs/manual/**/*.mdx",
    "docs/devs/**/*.mdx",
    "*.md",
  ],
}
