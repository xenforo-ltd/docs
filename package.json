{
  "name": "docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "gen-api-docs": "docusaurus gen-api-docs all",
    "clean-api-docs": "docusaurus clean-api-docs all",
    "lint": "pnpm run --no-bail \"/^lint:/\"",
    "lint:format": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:spell": "cspell lint --config cspell.json --no-progress \"docs/**/*.{md,mdx}\" \"README.md\" \"CONTRIBUTING.md\"",
    "lint:types": "tsc",
    "fix": "pnpm fix:format && pnpm fix:md",
    "fix:format": "prettier --write .",
    "fix:md": "markdownlint-cli2 --fix"
  },
  "dependencies": {
    "@docusaurus/core": "~3.10.2",
    "@docusaurus/faster": "~3.10.2",
    "@docusaurus/plugin-content-docs": "~3.10.2",
    "@docusaurus/preset-classic": "~3.10.2",
    "@docusaurus/theme-common": "~3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-openapi-docs": "~5.2.0",
    "docusaurus-theme-openapi-docs": "~5.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "~3.10.2",
    "@docusaurus/tsconfig": "~3.10.2",
    "@docusaurus/types": "~3.10.2",
    "@types/react": "^19.3.0",
    "cspell": "~10.3.3",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "~3.9.9",
    "typescript": "~7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.8.2",
      "onFail": "download"
    }
  }
}
